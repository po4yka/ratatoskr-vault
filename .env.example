# Every variable a Ratatoskr Vault process reads, with its default.
#
# One mechanism: the environment, prefixed RATATOSKR__, nesting separated by __. There is no
# configuration file. This table is the human-readable twin of `VaultConfig::defaults()` in
# crates/core/src/config/model.rs; a variable here and a field there must correspond exactly.
#
# Copy to `.env` for `cargo run` (gitignored) or set the variables in your deployment's
# environment. Secrets are marked; none has a default.

# ---- operator plane ---------------------------------------------------------------------------

# The admin listener: /health/live, /health/ready, /metrics, /version.
# Loopback by default on purpose; a deployment sets 0.0.0.0 deliberately and startup warns.
RATATOSKR__ADMIN__BIND=127.0.0.1:9570

# ---- database ---------------------------------------------------------------------------------
# Optional at this milestone: absent means probes serve and readiness reports no database check.
# SECRET: the URL carries the credential and is never logged or echoed.
# Ranges: MAX_CONNECTIONS 1..=100 (default 10), ACQUIRE_TIMEOUT_SECONDS 1..=30 (default 5).
#RATATOSKR__DATABASE__URL=postgres://vault:vault@127.0.0.1:5432/vault
#RATATOSKR__DATABASE__MAX_CONNECTIONS=10
#RATATOSKR__DATABASE__ACQUIRE_TIMEOUT_SECONDS=5

# ---- shutdown ---------------------------------------------------------------------------------

# Seconds to keep serving after SIGTERM while readiness already reports 503. 0..=60, default 5.
#RATATOSKR__SHUTDOWN__DRAIN_SECONDS=5

# Seconds allowed for in-flight requests after the listener stops accepting.
# 1..=120, default 25, and DRAIN + GRACE must not exceed 120 (the supervisor's stop timeout).
#RATATOSKR__SHUTDOWN__GRACE_SECONDS=25

# ---- mirrors ----------------------------------------------------------------------------------

# Both roots are absolute and distinct. ROOT contains published identifier-derived bare mirrors;
# WORK_ROOT contains only run-owned clone staging and is cleaned after each terminal run.
# Lifecycle is disabled unless the whole section is supplied. Both budgets are finite positive
# byte ceilings. Four concurrent Git operations match the Raspberry Pi 5's four CPU cores.
#RATATOSKR__MIRROR__ROOT=/mnt/nvme/ratatoskr/vault
#RATATOSKR__MIRROR__WORK_ROOT=/mnt/nvme/ratatoskr/vault-work
#RATATOSKR__MIRROR__PER_MIRROR_MAX_BYTES=10737418240
#RATATOSKR__MIRROR__GLOBAL_MAX_BYTES=214748364800
#RATATOSKR__MIRROR__MAX_CONCURRENT_OPERATIONS=4

# ---- Git LFS ---------------------------------------------------------------------------------

# Optional as one complete section and used only for targets whose authorized policy explicitly
# includes LFS. BINARY and all roots are validated before execution; staging participates in the
# target's quota decision and every limit is finite and positive.
#RATATOSKR__LFS__BINARY=/usr/bin/git-lfs
#RATATOSKR__LFS__STAGE_MAX_BYTES=10737418240
#RATATOSKR__LFS__MAX_OBJECTS=100000
#RATATOSKR__LFS__OPERATION_TIMEOUT_SECONDS=300

# ---- verification and restore drills ----------------------------------------------------------

# Optional as one complete section. SCRATCH_ROOT must be absolute and disjoint from both mirror
# roots. Every interval, sample, byte budget, concurrency and deadline is finite and positive;
# MAX_CONCURRENT is 1..=4. Deferrals remain due for a later scheduler pass.
#RATATOSKR__VERIFICATION__SCRATCH_ROOT=/mnt/nvme/ratatoskr/vault-restore-scratch
#RATATOSKR__VERIFICATION__VERIFICATION_FREQUENCY_SECONDS=86400
#RATATOSKR__VERIFICATION__DRILL_FREQUENCY_SECONDS=604800
#RATATOSKR__VERIFICATION__SAMPLE_SIZE=4
#RATATOSKR__VERIFICATION__SCRATCH_BYTE_BUDGET=21474836480
#RATATOSKR__VERIFICATION__MAX_CONCURRENT=2
#RATATOSKR__VERIFICATION__PER_DRILL_TIMEOUT_SECONDS=300
# SECRET: exactly 32 bytes encoded as 64 lowercase hexadecimal characters; never logged.
#RATATOSKR__VERIFICATION__MANIFEST_SIGNING_SEED=<64-lowercase-hex-characters>
# Key name is SHA-256 of the 32-byte Ed25519 public key; value is that key in lowercase hex.
#RATATOSKR__VERIFICATION__TRUSTED_MANIFEST_PUBLIC_KEYS__<KEY_ID>=<64-lowercase-hex-characters>

# ---- off-host S3-compatible replicas ----------------------------------------------------------

# Targets are keyed by an operator-assigned identity. Supply the whole target through environment
# variables; credentials have no defaults and are never serialized. HTTPS is mandatory except for
# loopback test endpoints. Every deadline and backlog/object limit is finite and positive.
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__ENDPOINT=https://s3.example.invalid
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__BUCKET=ratatoskr-vault
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__REGION=us-east-1
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__KEY_PREFIX=vault
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__ENABLED=true
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__REQUIRED=true
# SECRET: environment only; use credentials restricted to this bucket and prefix.
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__ACCESS_KEY=<access-key>
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__SECRET_ACCESS_KEY=<secret-access-key>
# SECRET: optional for temporary credentials.
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__SESSION_TOKEN=<session-token>
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__CONNECT_TIMEOUT_SECONDS=5
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__REQUEST_TIMEOUT_SECONDS=300
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__ATTEMPT_TIMEOUT_SECONDS=60
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__MAX_OBJECT_BYTES=21474836480
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__MAX_BACKLOG_ITEMS=64
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__MAX_BACKLOG_BYTES=42949672960
#RATATOSKR__REPLICAS__TARGETS__OFFSITE__MAX_CONCURRENT=2

# ---- telemetry --------------------------------------------------------------------------------

# json (default, what log collectors parse) | pretty (human-readable, for cargo run).
#RATATOSKR__TELEMETRY__LOG_FORMAT=json

# A tracing-subscriber EnvFilter directive string. Must parse or the process refuses to start.
#RATATOSKR__TELEMETRY__LOG_FILTER=info

# Optional OTLP/gRPC span export. Absent means spans carry real trace ids but nothing is exported,
# and startup warns once. ENDPOINT must be http:// or https://; TIMEOUT_SECONDS is 1..=60 (5).
# SECRET: HEADERS values (e.g. collector authentication) are never logged.
#RATATOSKR__TELEMETRY__OTLP__ENDPOINT=https://collector.example:4317
#RATATOSKR__TELEMETRY__OTLP__TIMEOUT_SECONDS=5
#RATATOSKR__TELEMETRY__OTLP__HEADERS__AUTHORIZATION=bearer-not-a-real-credential
